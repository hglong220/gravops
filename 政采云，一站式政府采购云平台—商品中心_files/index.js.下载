(function () {
  try {
    // 不执行脚本的域名
    var excludeSit = ['pageoffice','hall.zcy.gov.cn','www.zcy.gov.cn'];
    /**
     * ajax 简易封装
     */
    var ajax = {};
    ajax.httpRequest = function () {
      if (window.XMLHttpRequest) {
        return new XMLHttpRequest();
      }
      var versions = [
        "MSXML2.XmlHttp.6.0",
        "MSXML2.XmlHttp.5.0",
        "MSXML2.XmlHttp.4.0",
        "MSXML2.XmlHttp.3.0",
        "MSXML2.XmlHttp.2.0",
        "Microsoft.XmlHttp"
      ];
      var xhr;
      for (var i = 0; i < versions.length; i++) {
        try {
          xhr = new ActiveXObject(versions[i]);
          break;
        } catch (e) {}
      }
      return xhr;
    };

    ajax.send = function (url, callback, method, data, async) {
      if (async === undefined) {
        async = true;
      }
      var httpRequest = ajax.httpRequest();
      httpRequest.open(method, url, async);
      httpRequest.onreadystatechange = function () {
        if (httpRequest.readyState == 4) {
          callback(httpRequest)
        }
      };
      httpRequest.send(data);
    };
    ajax.get = function (url, data, callback, async) {
      var query = [];
      for (var key in data) {
        query.push(encodeURIComponent(key) + '=' + encodeURIComponent(data[key]));
      }
      ajax.send(url + (query.length ? '?' + query.join('&') : ''), callback, 'GET', null, async)
    };
    /**
     * cookie get、set
     */
    function setCookie(c_name, value) {
      var exdate = new Date();
      var expiredays = 30;
      exdate.setDate(exdate.getDate() + expiredays);
      document.cookie = c_name + "=" + escape(value) +
        ((expiredays == null) ? "" : ";expires=" + exdate.toGMTString())
    }

    function getCookie(c_name) {
      if (document.cookie.length > 0) {
        c_start = document.cookie.indexOf(c_name + "=")
        if (c_start != -1) {
          c_start = c_start + c_name.length + 1
          c_end = document.cookie.indexOf(";", c_start)
          if (c_end == -1) c_end = document.cookie.length
          return unescape(document.cookie.substring(c_start, c_end))
        }
      }
      return null
    }

    /**
     * polyfill for IE:bind
     */
    if (!Function.prototype.bind) {
      Function.prototype.bind = function (oThis) {
        if (typeof this !== "function") {
          throw new TypeError("Function.prototype.bind - what is trying to be bound is not callable");
        }
        var aArgs = Array.prototype.slice.call(arguments, 1),
          fToBind = this,
          fNOP = function () {},
          fBound = function () {
            return fToBind.apply(this instanceof fNOP && oThis ? this : oThis,
              aArgs.concat(Array.prototype.slice.call(arguments)));
          };
        fNOP.prototype = this.prototype;
        fBound.prototype = new fNOP();
        return fBound;
      };
    }


    /**
     * 检测session超时、主动刷新session状态
     */
    var sessionChecker = function () {
      //session超时时间
      this.timeOut = 1000 * 60 * 60 * 4 + 1000 * 60;
      //session检测周期
      this.period = 1000 * 60 * 5;
      // 超时后跳转链接
      this.logoutUrl = null;
      this.userId = null;
      //上次操作时间
      setCookie('operateTime', new Date().getTime());

      this._timer = null;

      this.getInfo();

      this.listenOperationEvent();

      this._timer = setInterval(function () {
        var operateTime = parseInt(getCookie('operateTime')),
          hasOperation = false,
          sessionOut = false;
        // 一个检测周期内是否有操作
        if (new Date() - operateTime <= this.period) {
          hasOperation = true;
        }
        // 未操作时间是否大于session失效时间
        if (new Date() - operateTime > this.timeOut) {
          sessionOut = true;
        }
        this.check({
          hasOperation: hasOperation,
          sessionOut: sessionOut
        });
      }.bind(this), this.period)
    }
    // 获取基本信息
    sessionChecker.prototype.getInfo = function () {
      ajax.get('/api/user/keepSessionAliveForAllPlatformfromMember?t=' + new Date().getTime(), null, function (e) {
        if (e.status === 200) {
          try {
            var res = JSON.parse(e.response);
            this.logoutUrl = res.logoutUrl;
            this.userId = res.userId;
          } catch (error) {
            clearInterval(this._timer);
          }
        } else {
          clearInterval(this._timer);
        }
      }.bind(this))
    }

    // 记录上次页面操作时间
    sessionChecker.prototype.listenOperationEvent = function () {
      document.onmousedown =
        document.onscroll =
        document.onkeypress =
        document.onmouseover = function () {
          setCookie('operateTime', new Date().getTime());
        }
    }

    sessionChecker.prototype.check = function (params) {

      if (params.hasOperation) {
        ajax.get('/api/user/keepSessionAliveForAllPlatformfromMember?t=' + new Date().getTime(), null, function (e) {
          if (e.status === 401 || e.status === 403) {
            clearInterval(this._timer);
            this.showModal(2);
          }
        }.bind(this))
        return;
      }
      if (params.sessionOut) {
        clearInterval(this._timer);
        this.showModal(1);
      } else {
        ajax.get('/api/user/checkSessionAliveForAllPlatformfromMember?t=' + new Date().getTime() + '&code=' + this.userId, null, function (e) {
          if (e.status === 401 || e.status === 403) {
            clearInterval(this._timer);
            this.showModal(2);
          }
        }.bind(this))
      }
    }

    sessionChecker.prototype.showModal = function (type) {
      var title;
      var detail;
      if (type === 1) {
        title = '您的账号长时间未操作，会话超时失效。';
        detail = '点击确认跳转登录页面';
      }
      if (type === 2) {
        title = '您的账号被其他用户登录，会话失效。';
        detail = '1、为了您的账号安全请重新登录修改密码。<br>2、请联系您的机构管理员增加您的专用账号。<br><br>点击确认跳转登录页面';
      }
      var html =
        '<div class="session-modal">' +
        '<div class="session-modal-title">' +
        '<i class="icon-pokeball icon-pokeball-notify-error"></i> ' +
        '<span>' + title + '</span>' +
        '</div>' +
        '<div class="session-modal-content">' +
        detail +
        '</div>' +
        '<div class="session-modal-footer">' +
        '<button class="session-modal-button" id="session-modal-button">确定</button>' +
        '</div>' +
        '</div>';
      var dom = document.createElement('div');
      dom.className = "session-mask";
      dom.innerHTML = html;
      document.body.appendChild(dom);
      document.getElementById('session-modal-button').onclick = function () {
        location.href = this.logoutUrl;
      }.bind(this)
    }
    /**
     * 如果在排除的域名下，就不执行此脚本
     */
