generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  phone       String?   @unique
  password    String
  name        String?
  companyName String?
  creditCode  String?
  isBanned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  licenses    License[]
  orders      Order[]

  @@index([email])
  @@index([phone])
  @@index([companyName])
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  plan          String
  amount        Int
  status        String   @default("pending")
  paymentMethod String   @default("wechat")
  licenseKey    String?
  paidAt        DateTime?
  transactionId String?  @unique
  companyName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  license       License?
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model License {
  id            String        @id @default(cuid())
  key           String        @unique
  userId        String?
  orderId       String?       @unique
  companyName   String
  companyDomain String?
  plan          String
  maxDevices    Int           @default(1)
  maxUsers      Int           @default(1)
  monthlyQuota  Int           @default(100)
  createdAt     DateTime      @default(now())
  expiresAt     DateTime
  status        String        @default("active")
  suspendReason String?
  devices       Device[]
  order         Order?        @relation(fields: [orderId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])
  usageRecords  UsageRecord[]

  @@index([key])
  @@index([userId])
  @@index([companyName])
}

model Device {
  id          String   @id @default(cuid())
  licenseId   String
  fingerprint String
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())
  license     License  @relation(fields: [licenseId], references: [id])

  @@unique([licenseId, fingerprint])
  @@index([licenseId])
}

model UsageRecord {
  id          String   @id @default(cuid())
  licenseId   String
  productName String
  status      String
  createdAt   DateTime @default(now())
  license     License  @relation(fields: [licenseId], references: [id])

  @@index([licenseId])
  @@index([createdAt])
}

model Product {
  id           String          @id @default(cuid())
  zcyProductId String?         @unique
  name         String
  originalName String?
  category     String?
  status       String
  isTrojan     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  riskLevel    String?
  trojanStatus String?
  images       ImageResource[]

  @@index([status])
  @@index([zcyProductId])
}

model ImageResource {
  id          String   @id @default(cuid())
  url         String
  source      String
  originalUrl String?
  width       Int?
  height      Int?
  size        Int?
  productId   String?
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id])

  @@index([url])
}

model CrawlerLog {
  id           String   @id @default(cuid())
  target       String
  status       String
  duration     Int
  itemsFound   Int
  errorMessage String?
  createdAt    DateTime @default(now())
}

model ProductDraft {
  id           String    @id @default(cuid())
  userId       String
  originalUrl  String
  originalId   String?
  shopName     String?
  title        String
  categoryPath String?
  categoryId   String?
  brand        String?
  model        String?
  images       String
  attributes   String
  skuData      String
  detailHtml   String
  status       String    @default("pending")
  publishUrl   String?
  templateId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  copyTaskId   String?
  detailImages String?
  errorMessage String?
  price        Float?
  publishedAt  DateTime?
  stock        Int?      @default(99)
  copyTask     CopyTask? @relation(fields: [copyTaskId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([originalUrl])
}

model CopyTask {
  id           String         @id @default(cuid())
  userId       String
  shopUrl      String
  shopName     String?
  totalCount   Int            @default(0)
  successCount Int            @default(0)
  failedCount  Int            @default(0)
  status       String         @default("running")
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  drafts       ProductDraft[]

  @@index([userId])
  @@index([status])
}

model ComplianceRule {
  id        String   @id @default(cuid())
  content   String
  region    String   @default("Global")
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  module    String
  message   String
  meta      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
}

// ========== 类目匹配系统 ==========

/// 类目模板库 - 缓存已匹配的商品类目，避免重复调用AI
model CategoryTemplate {
  id           String   @id @default(cuid())
  /// 标题关键词（提取的核心词，如 "A4复印纸"）
  titleKey     String
  /// 电商平台（JD, TMALL, SUNING, ZCY）
  platform     String?
  /// 品牌名（可选）
  brand        String?
  /// 完整类目路径 JSON数组，如 ["办公设备", "办公用纸", "打印纸"]
  categoryPath String
  /// 命中次数（越高说明越常用）
  hitCount     Int      @default(1)
  /// 置信度（0-1）
  confidence   Float    @default(1.0)
  /// 来源（template=手动模板, ai=AI匹配, rule=规则匹配）
  source       String   @default("ai")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([titleKey, platform, brand])
  @@index([titleKey])
  @@index([platform])
  @@index([hitCount])
}

/// 用户权限类目 - 存储每个用户/商户有权限的类目
model UserCategoryPermission {
  id             String   @id @default(cuid())
  /// 许可证Key（关联用户）
  licenseKey     String
  /// 电子卖场（如 "网上超市(青海网超)"）
  market         String?
  /// 一级类目名（如 "办公设备"）
  level1Category String
  /// 该一级类目下的所有子类目路径 JSON（完整的子树）
  subCategories  String
  /// 最后更新时间
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([licenseKey, level1Category])
  @@index([licenseKey])
  @@index([level1Category])
}

/// RPA 学习记录 - 存储成功的操作序列
model RpaLearningRecord {
  id            String   @id @default(cuid())
  /// 类目路径哈希（用于快速查找）
  pathHash      String   @unique
  /// 完整类目路径 JSON: ["办公设备", "办公用纸", "打印/复印纸"]
  categoryPath  String
  /// 操作序列 JSON: [{ action, target, value }]
  operations    String
  /// 成功执行次数
  successCount  Int      @default(1)
  /// 最后使用时间
  lastUsedAt    DateTime @default(now())
  /// 创建时间
  createdAt     DateTime @default(now())

  @@index([pathHash])
  @@index([successCount])
}

/// 政采云发布模板 - 用于保存用户常用发布配置
model ZcyPublishTemplate {
  id           String   @id @default(cuid())
  userId       String
  name         String
  /// 电子卖场名称，如 "青海网超"
  market       String
  /// 卖场代码（可选）
  marketCode   String?
  /// 类目路径 JSON数组: ["一级","二级","三级"]
  categoryPath String
  /// 标项名称（可选）
  bidItemName  String?
  /// 关键属性映射 JSON
  keyAttrs     String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, name], name: "userId_name")
  @@index([userId])
  @@index([market])
}
