DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# DeepSeek API (用于AI类目匹配)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Redis（队列/限流可用）
REDIS_URL=redis://:PASSWORD@HOST:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth / Security
# IMPORTANT: 生产环境务必设置强随机密钥（不要使用默认值）
JWT_SECRET=your_jwt_secret_here
PLUGIN_JWT_SECRET=your_plugin_jwt_secret_here
PLUGIN_TOKEN_TTL=12h
ADMIN_SECRET_TOKEN=your_admin_secret_token_here
ADMIN_EMAILS=admin@example.com

# Puppeteer（服务器上可指定 Chrome 路径）
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# 采集并发控制（避免瞬间启动过多浏览器导致服务器崩溃）
SCRAPE_MAX_CONCURRENCY=2
SCRAPE_MAX_WAIT_MS=20000

# 接口限流（可按需调整）
RATE_LIMIT_PLUGIN_SESSION_MAX=20
RATE_LIMIT_PLUGIN_SESSION_WINDOW_MS=600000
RATE_LIMIT_PLUGIN_COPY_MAX=30
RATE_LIMIT_PLUGIN_COPY_WINDOW_MS=60000

# SMS（注册验证码）
# 开发环境默认 SMS_PROVIDER=console（会在服务端日志打印验证码）；生产建议用 webhook 接入第三方短信服务
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=

# 验证码存储/校验
AUTH_CODE_TTL_MS=300000
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_SECRET=your_auth_code_secret_here

# 发送验证码限流
RATE_LIMIT_AUTH_SEND_CODE_MAX=5
RATE_LIMIT_AUTH_SEND_CODE_WINDOW_MS=600000
